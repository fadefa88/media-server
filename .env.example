NODE_ENV=production
MEDIA_ROOT=/media
MEDIA_EXCLUDE=/media/Foto
CLIENT_FIRST=true
TRACK_OPTIMIZER=true
VIDEO_TRANSCODE_ENABLED=false
SOFTWARE_VIDEO_TRANSCODE=false
SESSION_SECRET=replace_me

TRANSCODE_ROOT=/opt/vela/transcode
PLAYBACK_SESSION_TTL_MS=1800000
PLAYBACK_READY_TIMEOUT_MS=15000

POSTGRES_DB=vela
POSTGRES_USER=vela
POSTGRES_PASSWORD=replace_me

# TMDB: use the API Read Access Token (Bearer), never expose it to the browser.
TMDB_API_TOKEN=replace_with_tmdb_read_access_token
TMDB_LANGUAGE=it-IT
TMDB_REGION=IT
TMDB_DELAY_MS=220

DEFAULT_PROFILE=default
DEFAULT_PROFILE_NAME=Home
