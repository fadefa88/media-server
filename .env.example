NODE_ENV=production
MEDIA_ROOT=/media
MEDIA_EXCLUDE=/media/Foto
CLIENT_FIRST=true
TRACK_OPTIMIZER=true
VIDEO_TRANSCODE_ENABLED=false
SOFTWARE_VIDEO_TRANSCODE=false
SESSION_SECRET=replace_me

TRANSCODE_ROOT=/opt/vela/transcode
PLAYBACK_SESSION_TTL_MS=1800000
PLAYBACK_READY_TIMEOUT_MS=15000

# Optional signed playback capabilities for external /stream and /playback routes.
# Use at least 32 random characters, e.g. `openssl rand -hex 32`.
# The generated URLs remain relative, so nginx can keep LAN playback local and
# redirect only the public Cloudflare path to stream.lucahome.uk.
STREAM_SIGNING_SECRET=
STREAM_SIGNING_TTL_SECONDS=21600

POSTGRES_DB=vela
POSTGRES_USER=vela
POSTGRES_PASSWORD=replace_me

# LDF Media Server authentication. Enable only after setting a strong username/password.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=
MAX_AUTH_SESSIONS=2
AUTH_SESSION_TTL_DAYS=30
# Set true only when the origin is always reached through HTTPS. When behind a proxy,
# x-forwarded-proto=https also enables the Secure cookie automatically.
AUTH_SECURE_COOKIE=false

# Incremental library scan. Unchanged files are not re-probed with ffprobe.
SCAN_INTERVAL_MINUTES=15

# TMDB: use the API Read Access Token (Bearer), never expose it to the browser.
TMDB_API_TOKEN=replace_with_tmdb_read_access_token
TMDB_LANGUAGE=it-IT
TMDB_REGION=IT
TMDB_DELAY_MS=220

# Metadata Rescue. TVmaze and AniList work without API keys.
TVMAZE_ENABLED=true
TVMAZE_DELAY_MS=550
ANILIST_ENABLED=true
ANILIST_DELAY_MS=2200

# Optional. OMDb free keys are useful to recover IMDb IDs, then the server returns to TMDB /find.
OMDB_API_KEY=

# Automatic matches below this confidence are never silently accepted.
METADATA_AUTO_CONFIDENCE=74
METADATA_REVIEW_CONFIDENCE=48

DEFAULT_PROFILE=default
DEFAULT_PROFILE_NAME=Home
